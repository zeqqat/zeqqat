{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.zeqqat/zeqqat",
  "title": "Zeqqat",
  "description": "The MCP gateway for Dokploy: agents deploy and fix apps without holding keys or seeing secrets.",
  "version": "0.6.2",
  "websiteUrl": "https://zeqqat.com",
  "icons": [
    { "src": "https://zeqqat.com/zeqqat.svg", "mimeType": "image/svg+xml", "sizes": ["any"] },
    { "src": "https://zeqqat.com/zeqqat-256.png", "mimeType": "image/png", "sizes": ["256x256"] }
  ],
  "repository": { "url": "https://github.com/zeqqat/zeqqat", "source": "github" },
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://zeqqat.com/{org}/mcp/{name}/{id}",
      "variables": {
        "org": { "description": "Your Zeqqat username or organization", "isRequired": true },
        "name": { "description": "MCP URL name, from the Zeqqat dashboard (MCP URLs)", "isRequired": true },
        "id": { "description": "MCP URL short id, from the Zeqqat dashboard (MCP URLs)", "isRequired": true }
      }
    }
  ]
}
