# Copy to .env and fill in. .env is gitignored; never commit real values.
# docker-compose.yml reads the same file.

# Public base URL of this install, with no trailing slash. Every absolute URL
# the app builds (OAuth redirects, MCP connection URLs) derives from it.
ZEQQAT_PUBLIC_URL=http://localhost:3000

# "self-hosted" (the default) or "cloud". Only the hosted zeqqat.com sets cloud.
ZEQQAT_EDITION=self-hosted

# Postgres connection string. docker-compose.yml builds this for you from
# POSTGRES_PASSWORD, so set it only when running the app outside compose.
DATABASE_URL=postgresql://zeqqat:change-me@localhost:5432/zeqqat

# Password for the bundled Postgres in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# AES-256-GCM key that encrypts stored Dokploy API keys. Must decode to
# exactly 32 bytes. Generate once with: openssl rand -base64 32
# Keep it safe: a new key makes every stored API key unreadable.
ZEQQAT_ENCRYPTION_KEY=replace-me

# Comma-separated sign-in providers: google, github.
ENABLED_AUTH_PROVIDERS=github

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: <ZEQQAT_PUBLIC_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Redirect URI: <ZEQQAT_PUBLIC_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Extra browser origins allowed to call connection URLs, comma-separated.
# ZEQQAT_ALLOWED_ORIGINS=

# Optional. Set to 0 to skip applying database migrations on startup.
# ZEQQAT_AUTO_MIGRATE=1

# Optional. Set to 0 to skip importing the bundled Dokploy catalog on startup.
# ZEQQAT_CATALOG_SYNC=1

# Optional. Umami analytics. Unset means no tracking at all.
# UMAMI_SCRIPT_URL=
# UMAMI_WEBSITE_ID=
