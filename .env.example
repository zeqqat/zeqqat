# Copy to .env and fill in. .env is gitignored; never commit real values.
# docker-compose.yml reads the same file.

# Public base URL of this install, with no trailing slash. Every absolute URL
# the app builds (OAuth redirects, MCP connection URLs) derives from it.
ZEQQAT_PUBLIC_URL=http://localhost:3000

# "self-hosted" (the default) or "cloud". Only the hosted zeqqat.com sets cloud.
ZEQQAT_EDITION=self-hosted

# Postgres connection string. docker-compose.yml builds this for you from
# POSTGRES_PASSWORD, so set it only when running the app outside compose.
DATABASE_URL=postgresql://zeqqat:change-me@localhost:5432/zeqqat

# Password for the bundled Postgres in docker-compose.yml.
POSTGRES_PASSWORD=change-me

# Session signing secret. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# AES-256-GCM key that encrypts stored Dokploy API keys. Must decode to
# exactly 32 bytes. Generate once with: openssl rand -base64 32
# Keep it safe: a new key makes every stored API key unreadable.
ZEQQAT_ENCRYPTION_KEY=replace-me

# Comma-separated sign-in providers: password, github, google, email.
# password needs nothing else: the first account you create owns this
# Zeqqat, and everyone else joins with an invite link. Forgotten passwords:
# an emailed link if a mailer is set below, otherwise the owner makes a
# reset link on the Team page. (zeqqat.com itself never offers password.)
ENABLED_AUTH_PROVIDERS=password

# GitHub OAuth app (github.com/settings/developers).
# Callback URL: <ZEQQAT_PUBLIC_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials).
# Redirect URI: <ZEQQAT_PUBLIC_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email sign-in (add "email" to ENABLED_AUTH_PROVIDERS). People get a 6-digit
# code by email. Needs MAIL_FROM plus one way to send: RESEND_API_KEY, or
# SMTP_URL (smtps://user:password@smtp.example.com:465). Without a mailer,
# email sign-in stays off even if listed.
MAIL_FROM=
RESEND_API_KEY=
SMTP_URL=

# Optional. Extra browser origins allowed to call connection URLs, comma-separated.
# ZEQQAT_ALLOWED_ORIGINS=

# Optional. Set to 0 to skip applying database migrations on startup.
# ZEQQAT_AUTO_MIGRATE=1

# Optional. Set to 0 to skip importing the bundled Dokploy catalog on startup.
# ZEQQAT_CATALOG_SYNC=1

# Optional. Set to 0 to turn off the anonymous install ping (a random install
# id and the version, sent to zeqqat.com on start and daily). DO_NOT_TRACK=1
# also turns it off. See "Anonymous install ping" in README.md.
# ZEQQAT_TELEMETRY=1

# Optional. Turns on the read-only operator stats API at /api/operator/*
# (sign-ups, usage, installs) for your own dashboard. At least 32 characters;
# send it as a Bearer token. Generate with: openssl rand -hex 32
# ZEQQAT_OPERATOR_KEY=

# Optional, for a dev or staging copy only. Adds "Start over as a new user"
# (and "Switch back to") to the account menu, so you can test the first-run
# flow through the real sign-in screens without deleting anything. Ignored
# on zeqqat.com. See lib/dev-tools.ts.
# ZEQQAT_DEV_TOOLS=1

# Optional. Umami analytics. Unset means no tracking at all.
# UMAMI_SCRIPT_URL=
# UMAMI_WEBSITE_ID=
